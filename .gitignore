# Arbeits-/Analyse-Dateien (NICHT deployen)
.planning/
assets/img/raw/
.playwright-mcp/
*.jpeg
!assets/img/**/*.jpeg
node_modules/
.DS_Store
Thumbs.db

# Verknuepfungsdaten der Supabase-CLI (enthalten Verbindungszeichenfolgen)
supabase/.temp/

# Agentenwerkzeug, kein Bestandteil der Website.
# Der Skills-Installer legt diese Ordner IM Projektordner an. Ohne diesen
# Ausschluss wandern sie beim naechsten "git add -A" in ein oeffentliches
# Repository und werden ueber GitHub Pages sogar ausgeliefert.
# Das Higgsfield-Zugangstoken liegt NICHT hier, sondern unter
# ~/.config/higgsfield/credentials.json — also ausserhalb des Projekts.
.agents/
.claude/
skills-lock.json

# Hinweis: .claude/ steht ganz hier, nicht nur .claude/skills/.
# launch.json des Vorschauservers nennt den vollen Windows-Pfad und
# damit den Benutzernamen; sie lag ueber GitHub Pages oeffentlich.

# Interne Arbeitsunterlagen — gehoeren NICHT ins oeffentliche Repository.
# Sie lagen bis v45 auf dem Arbeits-Branch oeffentlich lesbar auf GitHub,
# obwohl sie aus dem Live-Branch "main" sorgfaeltig herausgehalten wurden:
# beide Branches liegen im SELBEN oeffentlichen Repository. CLAUDE.md nennt
# unter anderem das Muster des Verwaltungspassworts.
# Sie bleiben auf der Platte, werden aber nicht mehr versioniert.
CLAUDE.md
CONTENT_INVENTORY.md
DESIGN-AND-MOTION-SYSTEM.md
IMAGE_SOURCES.md
SUPABASE.md

# supabase/ wird bewusst WIEDER versioniert (Entscheidung des Betreibers).
# Darin steht kein Geheimnis: Passwort, Dienstschluessel, GitHub-Token und
# SMTP-Zugang kommen alle aus Deno.env.get(), liegen also als Supabase-Secret.
# supabase/.temp/ bleibt ausgeschlossen (Zeile weiter oben) — dort liegt eine
# PostgreSQL-Verbindungszeichenfolge MIT Zugangsdaten.
